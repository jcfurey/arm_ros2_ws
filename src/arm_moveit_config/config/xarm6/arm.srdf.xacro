<?xml version="1.0"?>
<robot name="xarm6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="gripper" default="true"/>
  <xacro:property name="gripper" value="$(arg gripper)"/>
  <group name="arm"><chain base_link="link_base" tip_link="${'link_tcp' if gripper else 'link_eef'}"/></group>
  <!-- With a gripper the all-zero pose puts the fingers into the bench; home is
       then UFACTORY's "hold-up" pose. Gazebo and mock hardware start here
       (arm_description xarm6.urdf.xacro initial values). -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/><joint name="joint2" value="0"/><joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/><joint name="joint5" value="${-1.5708 if gripper else 0}"/><joint name="joint6" value="0"/>
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="joint1" value="0.3"/><joint name="joint2" value="-0.3"/><joint name="joint3" value="-0.8"/>
    <joint name="joint4" value="0"/><joint name="joint5" value="0.7"/><joint name="joint6" value="0"/>
  </group_state>
  <group_state name="sweep" group="arm">
    <joint name="joint1" value="0.9"/><joint name="joint2" value="-0.3"/><joint name="joint3" value="-0.8"/>
    <joint name="joint4" value="0"/><joint name="joint5" value="0.7"/><joint name="joint6" value="0"/>
  </group_state>
  <group_state name="blocked" group="arm">
    <joint name="joint1" value="-0.4"/><joint name="joint2" value="-0.3"/><joint name="joint3" value="-0.8"/>
    <joint name="joint4" value="0"/><joint name="joint5" value="0.7"/><joint name="joint6" value="0"/>
  </group_state>
  <!-- UFACTORY's arm collision exclusions; see third_party/ufactory/LICENSE. -->
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link3" reason="Never"/>
  <disable_collisions link1="link1" link2="link_base" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link4" reason="Never"/>
  <disable_collisions link1="link2" link2="link_base" reason="Never"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <disable_collisions link1="link3" link2="link6" reason="Never"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link6" reason="Never"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="link_eef" reason="Adjacent"/>
  <xacro:if value="${gripper}">
    <!-- UFACTORY xArm Gripper: group, states and collision exclusions from
         UFACTORY's xarm_moveit_config (see third_party/ufactory/LICENSE). -->
    <group name="gripper">
      <link name="xarm_gripper_base_link"/><link name="left_outer_knuckle"/><link name="left_finger"/>
      <link name="left_inner_knuckle"/><link name="right_inner_knuckle"/><link name="right_outer_knuckle"/>
      <link name="right_finger"/><link name="link_tcp"/>
      <joint name="drive_joint"/>
    </group>
    <!-- 85 mm between the pads, the xArm Gripper's rated stroke. The URDF's
         0 rad stop is 89 mm; held near it, the fingers swing past the stop
         when the arm accelerates (to -0.016 rad), and ros2_control
         deactivates a controller whose joint leaves its limits. -->
    <group_state name="open" group="gripper"><joint name="drive_joint" value="0.045"/></group_state>
    <group_state name="close" group="gripper"><joint name="drive_joint" value="0.85"/></group_state>
    <end_effector name="gripper" parent_link="link_tcp" group="gripper" parent_group="arm"/>
    <passive_joint name="left_finger_joint"/>
    <passive_joint name="left_inner_knuckle_joint"/>
    <passive_joint name="right_inner_knuckle_joint"/>
    <passive_joint name="right_outer_knuckle_joint"/>
    <passive_joint name="right_finger_joint"/>
    <!-- The linkage moves as one mechanism: no pair of its links is checked. -->
    <disable_collisions link1="xarm_gripper_base_link" link2="left_outer_knuckle" reason="Never"/>
    <disable_collisions link1="xarm_gripper_base_link" link2="left_finger" reason="Never"/>
    <disable_collisions link1="xarm_gripper_base_link" link2="left_inner_knuckle" reason="Never"/>
    <disable_collisions link1="xarm_gripper_base_link" link2="right_outer_knuckle" reason="Never"/>
    <disable_collisions link1="xarm_gripper_base_link" link2="right_finger" reason="Never"/>
    <disable_collisions link1="xarm_gripper_base_link" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="left_outer_knuckle" link2="left_finger" reason="Never"/>
    <disable_collisions link1="left_outer_knuckle" link2="left_inner_knuckle" reason="Never"/>
    <disable_collisions link1="left_outer_knuckle" link2="right_outer_knuckle" reason="Never"/>
    <disable_collisions link1="left_outer_knuckle" link2="right_finger" reason="Never"/>
    <disable_collisions link1="left_outer_knuckle" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="left_finger" link2="left_inner_knuckle" reason="Never"/>
    <disable_collisions link1="left_finger" link2="right_outer_knuckle" reason="Never"/>
    <disable_collisions link1="left_finger" link2="right_finger" reason="Never"/>
    <disable_collisions link1="left_finger" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="left_inner_knuckle" link2="right_outer_knuckle" reason="Never"/>
    <disable_collisions link1="left_inner_knuckle" link2="right_finger" reason="Never"/>
    <disable_collisions link1="left_inner_knuckle" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="right_outer_knuckle" link2="right_finger" reason="Never"/>
    <disable_collisions link1="right_outer_knuckle" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="right_finger" link2="right_inner_knuckle" reason="Never"/>
    <!-- Links the gripper bolts against or cannot reach. -->
    <disable_collisions link1="link5" link2="xarm_gripper_base_link" reason="Never"/>
    <disable_collisions link1="link5" link2="left_outer_knuckle" reason="Never"/>
    <disable_collisions link1="link5" link2="left_finger" reason="Never"/>
    <disable_collisions link1="link5" link2="left_inner_knuckle" reason="Never"/>
    <disable_collisions link1="link5" link2="right_outer_knuckle" reason="Never"/>
    <disable_collisions link1="link5" link2="right_finger" reason="Never"/>
    <disable_collisions link1="link5" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="link6" link2="xarm_gripper_base_link" reason="Never"/>
    <disable_collisions link1="link6" link2="left_outer_knuckle" reason="Never"/>
    <disable_collisions link1="link6" link2="left_finger" reason="Never"/>
    <disable_collisions link1="link6" link2="left_inner_knuckle" reason="Never"/>
    <disable_collisions link1="link6" link2="right_outer_knuckle" reason="Never"/>
    <disable_collisions link1="link6" link2="right_finger" reason="Never"/>
    <disable_collisions link1="link6" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="link_eef" link2="xarm_gripper_base_link" reason="Adjacent"/>
    <disable_collisions link1="link_eef" link2="left_outer_knuckle" reason="Never"/>
    <disable_collisions link1="link_eef" link2="left_finger" reason="Never"/>
    <disable_collisions link1="link_eef" link2="left_inner_knuckle" reason="Never"/>
    <disable_collisions link1="link_eef" link2="right_outer_knuckle" reason="Never"/>
    <disable_collisions link1="link_eef" link2="right_finger" reason="Never"/>
    <disable_collisions link1="link_eef" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="link4" link2="left_finger" reason="Never"/>
    <disable_collisions link1="link4" link2="left_inner_knuckle" reason="Never"/>
    <disable_collisions link1="link4" link2="right_finger" reason="Never"/>
    <disable_collisions link1="link4" link2="right_inner_knuckle" reason="Never"/>
  </xacro:if>
</robot>
