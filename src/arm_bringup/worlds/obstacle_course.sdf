    <model name="guard_wall"><static>true</static><pose>0.40 -0.47 1.02 0 0 0</pose>
      <link name="body"><collision name="solid"><geometry><box><size>0.55 0.035 0.54</size></box></geometry></collision>
        <visual name="appearance"><geometry><box><size>0.55 0.035 0.54</size></box></geometry><material><ambient>0.92 0.65 0.12 1</ambient><diffuse>0.92 0.65 0.12 1</diffuse><specular>0.25 0.25 0.25 1</specular><pbr><metal><metalness>0.15</metalness><roughness>0.6</roughness></metal></pbr></material></visual>
