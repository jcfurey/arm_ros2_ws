        <visual name="appearance"><geometry><box><size>0.035 0.26 0.20</size></box></geometry><material><ambient>0.15 0.58 0.48 1</ambient><diffuse>0.15 0.58 0.48 1</diffuse><specular>0.25 0.25 0.25 1</specular><pbr><metal><metalness>0.25</metalness><roughness>0.6</roughness></metal></pbr></material></visual>
