        <visual name="appearance"><geometry><box><size>0.07 0.07 0.67</size></box></geometry><material><ambient>0.12 0.17 0.21 1</ambient><diffuse>0.12 0.17 0.21 1</diffuse><specular>0.25 0.25 0.25 1</specular><pbr><metal><metalness>0.6</metalness><roughness>0.6</roughness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="bench_leg_11"><static>true</static><pose>0.67 0.47 0.335 0 0 0</pose>
      <link name="body"><collision name="solid"><geometry><box><size>0.07 0.07 0.67</size></box></geometry></collision>
        <visual name="appearance"><geometry><box><size>0.07 0.07 0.67</size></box></geometry><material><ambient>0.12 0.17 0.21 1</ambient><diffuse>0.12 0.17 0.21 1</diffuse><specular>0.25 0.25 0.25 1</specular><pbr><metal><metalness>0.6</metalness><roughness>0.6</roughness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="rear_screen"><static>true</static><pose>0 0.67 1.16 0 0 0</pose>
