    <model name="ouster_front_stand"><static>true</static><pose>1.35 -1.1 0.90 0 0 0</pose>
      <link name="body"><collision name="solid"><geometry><cylinder><radius>0.025</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="appearance"><geometry><cylinder><radius>0.025</radius><length>1.8</length></cylinder></geometry><material><ambient>0.12 0.18 0.22 1</ambient><diffuse>0.12 0.18 0.22 1</diffuse></material></visual>
