    </model>
    <model name="blocking_post"><static>true</static><pose>-0.067 -0.162 1.005 0 0 0</pose>
      <link name="body"><collision name="solid"><geometry><cylinder><radius>0.065</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="appearance"><geometry><cylinder><radius>0.065</radius><length>0.5</length></cylinder></geometry><material><ambient>0.92 0.22 0.13 1</ambient><diffuse>0.92 0.22 0.13 1</diffuse><specular>0.25 0.25 0.25 1</specular><pbr><metal><metalness>0.2</metalness><roughness>0.6</roughness></metal></pbr></material></visual>
