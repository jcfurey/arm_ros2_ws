<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="demo_arm">
  <xacro:arg name="hardware" default="mock"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="mount_xyz" default="0 0 0"/>
  <xacro:arg name="mount_rpy" default="0 0 0"/>
  <xacro:include filename="$(find arm_description)/urdf/materials.xacro"/>
  <xacro:property name="hardware" value="$(arg hardware)"/>
  <material name="blue"><color rgba="0.12 0.38 0.75 1"/></material>
  <material name="silver"><color rgba="0.65 0.68 0.72 1"/></material>
  <material name="dark"><color rgba="0.15 0.17 0.20 1"/></material>

  <link name="world"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.20 0.20 0.10"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><box size="0.20 0.20 0.10"/></geometry></collision>
    <inertial><origin xyz="0 0 0.05"/><mass value="3"/><inertia ixx="0.0125" ixy="0" ixz="0" iyy="0.0125" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="world_joint" type="fixed"><parent link="world"/><child link="base_link"/><origin xyz="$(arg mount_xyz)" rpy="$(arg mount_rpy)"/></joint>

  <xacro:macro name="arm_segment" params="index parent offset length radius mass axis color">
    <link name="link_${index}">
      <visual><origin xyz="0 0 ${length / 2}"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry><material name="${color}"/></visual>
      <collision><origin xyz="0 0 ${length / 2}"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry></collision>
      <inertial>
        <origin xyz="0 0 ${length / 2}"/><mass value="${mass}"/>
        <inertia ixx="${mass * (3 * radius * radius + length * length) / 12}" ixy="0" ixz="0"
                 iyy="${mass * (3 * radius * radius + length * length) / 12}" iyz="0" izz="${mass * radius * radius / 2}"/>
      </inertial>
    </link>
    <joint name="joint_${index}" type="revolute">
      <parent link="${parent}"/><child link="link_${index}"/>
      <origin xyz="0 0 ${offset}"/><axis xyz="${axis}"/>
      <limit lower="-2.8" upper="2.8" effort="80" velocity="1.5"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
  </xacro:macro>
  <xacro:arm_segment index="1" parent="base_link" offset="0.10" length="0.12" radius="0.05" mass="1.0" axis="0 0 1" color="silver"/>
  <xacro:arm_segment index="2" parent="link_1" offset="0.12" length="0.25" radius="0.035" mass="1.0" axis="0 1 0" color="blue"/>
  <xacro:arm_segment index="3" parent="link_2" offset="0.25" length="0.22" radius="0.03" mass="0.8" axis="0 1 0" color="blue"/>
  <xacro:arm_segment index="4" parent="link_3" offset="0.22" length="0.10" radius="0.028" mass="0.3" axis="1 0 0" color="silver"/>
  <xacro:arm_segment index="5" parent="link_4" offset="0.10" length="0.08" radius="0.025" mass="0.2" axis="0 1 0" color="blue"/>
  <xacro:arm_segment index="6" parent="link_5" offset="0.08" length="0.08" radius="0.022" mass="0.15" axis="0 0 1" color="silver"/>
  <xacro:gazebo_surface link="base_link" color="0.15 0.17 0.20 1"/>
  <xacro:gazebo_surface link="link_1" color="0.65 0.68 0.72 1" metalness="0.6"/>
  <xacro:gazebo_surface link="link_2" color="0.12 0.38 0.75 1"/>
  <xacro:gazebo_surface link="link_3" color="0.12 0.38 0.75 1"/>
  <xacro:gazebo_surface link="link_4" color="0.65 0.68 0.72 1" metalness="0.6"/>
  <xacro:gazebo_surface link="link_5" color="0.12 0.38 0.75 1"/>
  <xacro:gazebo_surface link="link_6" color="0.65 0.68 0.72 1" metalness="0.6"/>
  <link name="tool0"/>
  <joint name="tool_joint" type="fixed"><parent link="link_6"/><child link="tool0"/><origin xyz="0 0 0.08"/></joint>

  <xacro:macro name="control_joint" params="index">
    <joint name="joint_${index}">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>
  <ros2_control name="ArmSystem" type="system">
    <hardware>
      <xacro:if value="${hardware == 'gazebo'}"><plugin>gz_ros2_control/GazeboSimSystem</plugin></xacro:if>
      <xacro:unless value="${hardware == 'gazebo'}"><plugin>mock_components/GenericSystem</plugin></xacro:unless>
    </hardware>
    <xacro:control_joint index="1"/><xacro:control_joint index="2"/>
    <xacro:control_joint index="3"/><xacro:control_joint index="4"/>
    <xacro:control_joint index="5"/><xacro:control_joint index="6"/>
  </ros2_control>
  <xacro:if value="${hardware == 'gazebo'}">
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_file)</parameters>
        <!-- controller_manager times each update by its node clock, not by the
             simulation time it is given; gz_relay sends it every step. -->
        <ros><remapping>/clock:=/controller_manager/clock</remapping></ros>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
